<div id="api-token-one-time-secret"
  data-turbo-temporary
  data-controller="api-token-secret"
  class="rounded-2xl border-2 border-emerald-400 bg-emerald-50 p-6 text-emerald-950 shadow-lg dark:border-emerald-600 dark:bg-emerald-950/30 dark:text-emerald-100">
  <h2 class="text-xl font-bold">Copy this token now</h2>
  <p class="mt-2 text-sm">
    This is the only time the complete token will be shown. Refreshing or returning to
    this page removes it, and Meme Search cannot recover it later.
  </p>
  <code
    tabindex="0"
    data-api-token-secret-target="token"
    class="mt-4 block overflow-x-auto rounded-xl bg-slate-950 p-4 font-mono text-sm text-emerald-300"><%= raw_token %></code>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-action="api-token-secret#copy"
      class="rounded-xl bg-emerald-700 px-4 py-2 font-semibold text-white hover:bg-emerald-800">
      Copy token
    </button>
    <p data-api-token-secret-target="status" class="text-sm" role="status"></p>
  </div>
</div>
